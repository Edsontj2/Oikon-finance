# Postgres (Neon, Supabase ou qualquer outro)
DATABASE_URL="postgres://usuario:senha@host:5432/oikon"
# Segredo da sessão: no mínimo 32 caracteres aleatórios (ex.: openssl rand -base64 48)
AUTH_SECRET=""

# Assistente no WhatsApp (WhatsApp Business Platform / Cloud API oficial da Meta). Opcional.
# Token livre que você escolhe e repete no painel da Meta ao cadastrar o webhook.
WHATSAPP_VERIFY_TOKEN=""
# Chave secreta do app da Meta (confere a assinatura X-Hub-Signature-256 de cada chamada).
WHATSAPP_APP_SECRET=""
# Token de acesso permanente de um usuário do sistema, com permissão whatsapp_business_messaging.
WHATSAPP_TOKEN=""
# Id do número de telefone do WhatsApp Business que responde.
WHATSAPP_PHONE_NUMBER_ID=""
# Número do assistente só com dígitos (ex.: 5511999998888), mostrado na tela de vínculo.
WHATSAPP_DISPLAY_NUMBER=""
# Opcional: versão da API Graph (padrão v21.0).
WHATSAPP_API_VERSION=""
